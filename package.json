{
  "name": "ai-pacman-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bench:cnn": "node ./node_modules/vite-node/dist/cli.mjs scripts/cnn-bench.ts --",
    "bench:cnn:webgpu-chrome": "./scripts/open-webgpu-chrome.sh",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "eslint . --fix",
    "test:parallel-merge": "./scripts/test-parallel-merge.sh",
    "test:learning-smoke": "./scripts/learning-smoke.sh",
    "sweep:t1": "./scripts/t1-nstep-sweep.sh",
    "sweep:t2": "./scripts/t2-reward-sweep.sh",
    "sweep:t3": "./scripts/t3-potential-shaping-sweep.sh",
    "sweep:t5": "./scripts/t5-pac-region-sweep.sh",
    "sweep:short": "./scripts/short-learning-sweep.sh"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "undici": "7.29.0",
    "@eslint/eslintrc": {
      "js-yaml": "4.3.0"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    }
  }
}
